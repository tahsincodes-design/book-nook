# Base URL of the Express API (defaults to http://localhost:5000).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: imgbb API key for Add Book cover uploads.
# Without it, readers can still paste a cover image URL.
IMGBB_API_KEY=

# BetterAuth + MongoDB. Use the same database as the Express API so book
# ownership and borrow records share the reader email.
MONGODB_URI=mongodb://localhost:27017/booknook
MONGODB_DB=booknook
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth. Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" once both Google credentials above are filled in.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
